@app.get("/files")\
async def list_files():\
    return \{\
        "files": [\
            \{\
                "filename": item.name,\
                "size_bytes": item.stat().st_size\
            \}\
            for item in UPLOAD_DIR.iterdir()\
            if item.is_file()\
        ]\
    \}\
\
