# Copy to .env and edit.
PLANNER_DOMAIN=planner.example.com
# The exact origin of the HUD (GitHub Pages), with no trailing slash:
ALLOWED_ORIGIN=https://janhviwaman.github.io
# Long random string. Leave empty to disable the key (not recommended on a public host).
API_KEY=change-me-long-random-string
# Set to 1 to use the built-in synthetic terrain (no 90 MB download; for trying the stack only):
# SYNTHETIC=1
